datos.esc <- scale(datos)
boxplot(datos.esc, main = 'Boxplot de datos escalados', col = colores)
#Observamos que tenemos datos atipicos en las variables 'weight' y
#'height'
keys <- names(datos)
atipicos <- c()
for (i in c(1:length(keys)))
{
atipicos[[keys[i]]] <- boxplot(datos[i][,1],
main = paste('Boxplot', keys[i]),
xlab = keys[i], col = colores[i],
plot = FALSE)$out
}
indices <- c()
for (j in names(atipicos)){
for (i in atipicos[[j]]){
indices <- append(indices,which(datos[j] == i))
}
}
indices <- sort(indices)
datos.atipicos <- subset(datos[indices,],
select = c('weight', 'height'))
datos.atipicos$IMC <- datos.atipicos$weight / ((datos.atipicos$height/100)^2)
datos.atipicos
