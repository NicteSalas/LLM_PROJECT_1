    "            class_weights=class_weights,  # ← ¡Aquí pasamos los pesos!\n",
    "        )\n",
    "        \n",
    "# Entrenar\n",
    "trainer.train()\n",
    "        \n",
    "# Evaluar\n",
    "eval_results = trainer.evaluate()"
